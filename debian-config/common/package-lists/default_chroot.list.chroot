# Default live system packages
# Installed in the chroot stage; these are the base packages every
# image variant gets, on top of the "required/important" priorities.

# eatmydata: required by the eatmydata.udeb used in base-installer
eatmydata

# Packages needed by base-installer/post-base-installer.d/* hooks
sudo
locales
pciutils
usbutils
eject
tasksel

# EFI boot support (for GRUB on EFI systems)
efibootmgr

# Live system boot/config scripts
live-boot
live-config

# Filesystem tools
dosfstools
e2fsprogs
ntfs-3g
exfatprogs
exfat-fuse
xfsprogs
btrfs-progs
reiserfsprogs
f2fs-tools
jfsutils
squashfs-tools

# Synchronization tools
rsync

# Disk encryption
cryptsetup

# Audio (bluez lives in hardware.list.chroot)
pulseaudio
pulseaudio-module-bluetooth

# Network management
network-manager
network-manager-l10n

# Wireless (WPA client + access point)
wpasupplicant
hostapd
dbus

# Package management
packagekit

# OpenSSH
# For security reasons, the SSH server is NOT installed by default
# openssh-server

# System utilities
util-linux-extra
pkexec

# Memory testing
memtest86+
