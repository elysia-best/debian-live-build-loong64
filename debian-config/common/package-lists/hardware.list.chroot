# Hardware support packages
# Firmware, drivers and related tools for the live image.

##
## The b43 firmware requires network access, hence they are not
## dependencies of lingmo-linux-firmware. But we install them in the
## live image anyway, since we have network access while building.
##
firmware-linux-nonfree
firmware-linux
#if ARCHITECTURES i386 amd64
firmware-b43legacy-installer
firmware-b43-installer
#endif

##
## Install as many input/video drivers as we can. These packages need
## to be explicitly listed to be sure they are installed, because
## installing xserver-xorg alone is not enough (its dependencies are:
##   * xserver-xorg-input-all | xorg-driver-input
##   * xserver-xorg-video-all | xorg-driver-video
##
xserver-xorg-input-all
xserver-xorg-video-all

# linux-firmware
bluez-firmware
firmware-amd-graphics
firmware-ath9k-htc
firmware-atheros
firmware-brcm80211
firmware-intel-sound
firmware-iwlwifi
firmware-libertas
firmware-misc-nonfree
firmware-sof-signed
firmware-ti-connectivity
firmware-zd1211

#if ARCHITECTURES i386 amd64
broadcom-sta-dkms
#endif

# Initramfs
initramfs-tools

# Wireless
bluetooth
bluez
wireless-regdb
wireless-tools

# Firewall
ufw
iptables
#Alt: ferm
#Alt: iptables-persistent
#Alt: firehol
#Alt: fail2ban
#Alt: ipset-persistent
#Alt: crowdsec
#Alt: opensnitch

# Live system components (live-boot/live-config live in default_chroot.list.chroot)
live-boot-doc
live-config-doc
live-config-systemd
live-task-localisation
live-task-recommended
user-setup
live-tools
#Alt: installation-birthday

# Compression tools
zstd
xz-utils
